{
  "name": "game-systems-frontend-infra",
  "version": "0.1.0",
  "description": "Foundry + OpenZeppelin v5 constant-product AMM capstone protocol module",
  "type": "module",
  "scripts": {
    "build": "forge build && npm --prefix frontend run build",
    "test": "forge test",
    "lint": "npm --prefix frontend run lint",
    "deploy:op-sepolia": "forge script script/DeployOptimismSepolia.s.sol:DeployOptimismSepolia --rpc-url $OP_SEPOLIA_RPC_URL --broadcast --verify"
  },
  "keywords": [
    "solidity",
    "foundry",
    "amm",
    "defi",
    "uups",
    "openzeppelin",
    "optimism"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@chainlink/contracts": "^1.5.0",
    "@graphprotocol/graph-cli": "^0.98.1",
    "@graphprotocol/graph-ts": "^0.38.2",
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "forge-std": "github:foundry-rs/forge-std"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "private": true
}
